# FlashLiquidator Lab — copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_MODE=simulation
# Must stay "false". Any other value aborts startup: this build has no execution path.
LIVE_TRADING_ENABLED=false

DATABASE_URL=postgresql+psycopg://fll:change-me@postgres:5432/flashliquidator
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change-me

# RPC endpoints (server-side only; never exposed to the browser). Archive endpoints are needed for
# historical replay (milestone 4) and for backfill beyond a provider's free history window.
BASE_RPC_HTTP=
BASE_RPC_WS=
BASE_ARCHIVE_RPC=

ARBITRUM_RPC_HTTP=
ARBITRUM_RPC_WS=
ARBITRUM_ARCHIVE_RPC=

ETHEREUM_RPC_HTTP=
ETHEREUM_RPC_WS=
ETHEREUM_ARCHIVE_RPC=
ETHEREUM_ENABLED=false

# Single administrator (HTTP Basic). Generate the hash with: make admin-hash PASSWORD='your password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

MIN_NET_PROFIT_USD=5
MAX_FLASH_LOAN_USD=100000
MIN_FLASH_LOAN_USD=1000
POSITION_HEALTH_FACTOR_ALERT=1.05
# Leave empty to start indexing from (latest - 50,000 blocks). Set to the Aave V3 pool deployment block for a full history.
INDEXER_START_BLOCK_BASE=
INDEXER_START_BLOCK_ARBITRUM=

MONITOR_INTERVAL_SECONDS=30
INDEXER_POLL_INTERVAL_SECONDS=12
INDEXER_MAX_BLOCK_RANGE=2000
REORG_SAFETY_BLOCKS=12
SIMULATION_CONCURRENCY=2
API_RATE_LIMIT_PER_MINUTE=120
RAW_DATA_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Exposure. By default the dashboard listens on 127.0.0.1:3000 only (SSH tunnel or the caddy profile for remote use).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
# Public edge (docker compose --profile edge up -d): TLS certificate for this hostname + basic auth for everything.
PUBLIC_HOSTNAME=
EDGE_BASICAUTH_USER=admin
# bcrypt hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
EDGE_BASICAUTH_HASH=

# Anvil image (default ghcr.io/foundry-rs/foundry). Hosts that cannot pull ghcr.io can build infra/anvil/Dockerfile.
ANVIL_IMAGE=ghcr.io/foundry-rs/foundry:v1.0.0

# Frontend -> API (inside the compose network the browser talks to the frontend; the frontend proxies to api)
NEXT_PUBLIC_API_BASE=/api
API_INTERNAL_URL=http://api:8000
